# ─── Database ─────────────────────────────────────────────────────────────
# Supabase PostgreSQL — pooler URL for runtime (PgBouncer)
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-1-ap-northeast-1.pooler.supabase.com:5432/postgres?pgbouncer=true&connection_limit=1"
# Direct URL for Prisma Migrate / db push (bypasses pooler)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"

# ─── Auth (NextAuth v5) ──────────────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Kept for backward compatibility with NextAuth v4 libraries
NEXTAUTH_SECRET="same-as-AUTH_SECRET"
NEXTAUTH_URL="http://localhost:3000"

# ─── Google OAuth ─────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com > APIs & Services > Credentials
# Add redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxxxxxx"

# ─── Razorpay ─────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com > API Keys
# Use rzp_test_ keys for dev, rzp_live_ keys for production
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ─── Admin ────────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="use-a-strong-password"

# ─── Pricing (in paise — 4900 = ₹49) ─────────────────────────────────────
GATE_PRICE=4900
JEE_PRICE=4900
